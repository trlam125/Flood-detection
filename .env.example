# Server
APP_NAME=RIWA FloodEye Monitor
HOST=127.0.0.1
PORT=8000

# Segmentation backend: riwa or yolo
MODEL_BACKEND=riwa
RIWA_MODEL_PATH=models/riwa_unet_resnet34_deploy.pth
YOLO_WATER_MODEL_PATH=models/water_seg.pt

# Severity by flooded-area ratio
LOW_RATIO=0.10
MODERATE_RATIO=0.20
CRITICAL_RATIO=0.45
EMA_ALPHA=0.35

# Alerts
ALERT_MIN_SEVERITY=MODERATE
ALERT_CONFIRM_FRAMES=2
ALERT_COOLDOWN_SEC=300

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio SMS (optional)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
