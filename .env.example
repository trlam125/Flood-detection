# Server
APP_NAME=RIWA FloodEye Monitor
HOST=127.0.0.1
PORT=8000

# Segmentation backend: riwa or yolo
MODEL_BACKEND=riwa
# auto chooses CUDA when available; cuda requires a working GPU runtime; cpu forces CPU.
MODEL_DEVICE=auto
RIWA_MODEL_PATH=models/riwa_unet_resnet34_deploy.pth
YOLO_WATER_MODEL_PATH=models/water_seg.pt

# Severity by flooded-area ratio
LOW_RATIO=0.10
MODERATE_RATIO=0.20
CRITICAL_RATIO=0.45
# Temporal events (video clip time or live observation time)
ALERT_MIN_SEVERITY=MODERATE
ALERT_CONFIRM_SEC=3
ALERT_CLEAR_SEC=10
ALERT_REMINDER_SEC=300
ALERT_HYSTERESIS_RATIO=0.03
MAX_OBSERVATION_GAP_SEC=5
EMA_TIME_CONSTANT_SEC=1
# Upload replay is dashboard-only unless explicitly enabled here.
REPLAY_EXTERNAL_ALERTS_ENABLED=false
PREVIEW_IDLE_TIMEOUT_SEC=1800

# Live camera monitoring (one server process; increase only after measuring throughput)
LIVE_MAX_CAMERAS=1
# Put a real RTSP URL in .env, not in the dashboard or committed config.
# CAMERA_ROAD_RTSP=rtsp://username:password@192.168.1.100:554/stream

# Persistent notification outbox (attempts per automatic retry cycle)
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SEC=5
OUTBOX_RETRY_MAX_SEC=300
OUTBOX_LEASE_SEC=120

# Operations and free-space protection (GiB and percentage of each volume)
OPERATIONS_INTERVAL_SEC=10
TELEMETRY_RETENTION_DAYS=7
STORAGE_WARN_FREE_GB=5
STORAGE_CRITICAL_FREE_GB=1
STORAGE_WARN_FREE_PERCENT=10
STORAGE_CRITICAL_FREE_PERCENT=2

# Retention archives only database-owned expired media; pending work is protected.
# Archive is recoverable. Permanent removal is a separate explicit opt-in.
RETENTION_ENABLED=true
RETENTION_PURGE_ENABLED=false
RETENTION_UPLOAD_DAYS=30
RETENTION_OUTPUT_DAYS=30
RETENTION_EVIDENCE_DAYS=90
RETENTION_CACHE_DAYS=1
RETENTION_TRASH_DAYS=7
RETENTION_INTERVAL_SEC=900
RETENTION_BATCH_SIZE=100

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio SMS (optional)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
