# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows command scripts use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Model weights and other binary assets must not be normalized.
*.pt binary
*.pth binary
*.onnx binary
*.exe binary
*.dll binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.JPEG binary
*.png binary
*.PNG binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.MP4 binary
*.avi binary
*.mov binary
*.mkv binary
*.m4v binary
*.pdf binary
*.zip binary
*.gz binary
